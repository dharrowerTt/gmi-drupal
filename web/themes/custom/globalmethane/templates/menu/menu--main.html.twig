{# templates/menu/menu--main.html.twig #}
<ul class="navbar-nav mr-auto">
<!-- CUSTOM MENU TEMPLATE IN USE -->

  {% for item in items %}
    {% set has_dropdown = item.below is not empty %}
    <li class="nav-item {{ has_dropdown ? 'dropdown' : '' }}">
      <a href="{{ item.url }}"
         class="nav-link {{ has_dropdown ? 'dropdown-toggle' : '' }}"
         {% if has_dropdown %}
           id="navbarDropdown{{ loop.index }}"
           role="button"
           data-toggle="dropdown"
           aria-haspopup="true"
           aria-expanded="false"
         {% endif %}
      >
        {{ item.title }}
      </a>

      {% if has_dropdown %}
        <div class="dropdown-menu" aria-labelledby="navbarDropdown{{ loop.index }}">
          {% for sub_item in item.below %}
            <a class="dropdown-item" href="{{ sub_item.url }}">{{ sub_item.title }}</a>
          {% endfor %}
        </div>
      {% endif %}
    </li>
  {% endfor %}
</ul>

