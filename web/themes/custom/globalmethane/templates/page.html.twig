<!DOCTYPE html>
<html lang="en">
<head>
  <head-placeholder token="{{ placeholder_token|raw }}">
  {{ attach_library('globalmethane/global') }}
  <title>{{ head_title }}</title>
  <css-placeholder token="{{ placeholder_token|raw }}">
  <js-placeholder token="{{ placeholder_token|raw }}">
</head>

  <body>
  <div class="d-flex flex-column min-vh-100">
    {# Top bar (socials, search, etc.) #}
    {% if page.top %}
      <div class="bg-light py-1">
        <div class="container">
          {{ page.top }}
        </div>
      </div>
    {% endif %}

    {# Main site header/nav #}
    {% if page.header %}
<header role="banner">
  <div id="headerContainer">
<nav class="navbar navbar-light bg-light py-2">
  <div class="container d-flex justify-content-between align-items-center flex-wrap">
    
    <!-- GMI Logo + Branding, constrained -->
    <a class="navbar-brand d-flex align-items-center flex-shrink-1" href="/">
      <img src="https://gmidev.org/web/sites/default/files/2025-05/gmi-top.png" alt="GMI Home" style="height: 50px;" class="mr-2">
      <div class="d-none d-md-block"> <!-- Hide text on mobile to save space -->
        <div class="font-weight-bold mb-0 small">Global Methane Initiative (GMI)</div>
        <small class="text-muted">Leading methane action since 2004</small>
      </div>
    </a>

    <!-- Social/Search section flush right -->
    <div class="d-flex align-items-center ml-auto text-nowrap">
      <a class="nav-link px-2 text-dark" href="https://globalmethane.us19.list-manage.com/subscribe?..." target="_blank">Join Our Mailing List</a>
      <a class="nav-link px-2 text-dark" href="https://www.facebook.com/globalmethane" target="_blank"><i class="fab fa-facebook-f"></i></a>
      <a class="nav-link px-2 text-dark" href="https://twitter.com/globalmethane" target="_blank"><i class="fab fa-x-twitter"></i></a>
      <a class="nav-link px-2 text-dark" href="https://www.linkedin.com/company/global-methane-initiative-gmi-/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
      <a class="nav-link px-2 text-dark" href="/search/index.aspx">Search <i class="fa fa-search"></i></a>
    </div>
  </div>
</nav>

<style>
.navbar-dark .navbar-nav .nav-link {
    color: rgba(255, 255, 255, 1)!important;
}
</style>

<nav class="navbar navbar-expand-lg bg-dark navbar-dark" style="background:#1E5E7B!important;color:white;font-weight:bold;">
  <div class="container">
    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="mainNavbar">
      {{ page.primary_menu }}
    </div>
  </div>
</nav>

  </div>
</header>


    {% endif %}

    {# Carousel layout (full-width banner) #}
    {% if page.carousel %}
      <section id="carousel" class="py-4">
        <div class="container-fluid px-0">
          {{ page.carousel }}
        </div>
      </section>
    {% endif %}

    {# Hero image section (also full-width) #}
    {% if page.hero %}
      <section id="hero-image" class="py-5 text-white text-center" style="background-color: #003c5c;">
        <div class="container">
          {{ page.hero }}
        </div>
      </section>
    {% endif %}

    {# Intro + Quick Link Panel layout #}
    {% if page.intro_panel %}
      <section id="intro-panel" class="py-4">
        <div class="container">
          {{ page.intro_panel }}
        </div>
      </section>
    {% endif %}

<main role="main" class="py-5">
  {% if node and node.bundle == 'page' and node.id == 2 %}
    <div class="container">
      {{ page.content }}
    </div>
  {% else %}
    <div class="container">
      {{ page.content }}
    </div>
  {% endif %}
</main>








    {# Optional sidebar (currently unused) #}
    {% if page.sidebar_first %}
      <aside class="container py-3">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}

<footer role="contentinfo" class="bg-dark text-white pt-4">
  <div class="container-fluid containerFooter">
    <div class="container">
      <div class="row">
        <div class="col-sm-3">
          <ul class="list-unstyled">
            <li><a href="/" class="text-white">Home</a></li>
        
          </ul>
        </div>
        <div class="col-sm-3">
          <ul class="list-unstyled">
 <li><a href="https://globalmethane.us19.list-manage.com/subscribe?u=da591cea9e010abd0437239de&amp;id=a3abe26702" class="text-white">Join Our Mailing List</a></li>
          </ul>
        </div>
        <div class="col-sm-3">
          <ul class="list-unstyled">
            <li><a href="/challenge" class="text-white">Global Methane Challenge</a></li>
          </ul>
        </div>
        <div class="col-sm-3">
          <ul class="list-unstyled">
            <li><a href="/archive" class="text-white">Archive</a></li>
          </ul>
        </div>
      </div>
      <div class="row py-2">
        <div class="col-sm-12 text-center border-top border-light pt-3">
          <strong>Global Methane Initiative (GMI)</strong><br>
          <span class="small">Leading methane action since 2004</span>
        </div>
      </div>
    </div>
  </div>
</footer>


    <js-bottom-placeholder token="{{ placeholder_token|raw }}">
    </div>
  </body>
</html>
